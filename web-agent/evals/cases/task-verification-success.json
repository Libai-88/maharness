{
  "name": "task-verification-success",
  "description": "任务验收通过后才报告完成",
  "sandbox": { "files": { "deliverable.txt": "verified artifact" } },
  "messages": [{ "role": "user", "content": "Create and verify the requested artifact" }],
  "task": {
    "objective": "Confirm the artifact exists",
    "acceptance": [{ "type": "file_contains", "path": "deliverable.txt", "value": "verified artifact" }]
  },
  "requests": [{
    "chunks": [
      { "type": "delta", "text": "The artifact is ready." },
      { "type": "usage", "input": 20, "output": 8 },
      { "type": "done" }
    ]
  }],
  "expect": { "answerContains": ["artifact"], "llmCalls": 1, "noErrors": true, "taskOutcome": "verified" }
}
