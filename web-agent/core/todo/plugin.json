{
  "id": "todo",
  "name": "待办看板",
  "version": "0.1.0",
  "entry": "index.ts",
  "enabled": true,
  "compatibility": {
    "api": {
      "min": "3.0.0",
      "max": "3.0.0"
    }
  },
  "limits": {
    "lifecycleTimeoutMs": 30000
  },
  "permissions": {
    "capabilities": {
      "tool": ["todo_add", "todo_update", "todo_list", "item_list", "item_get", "item_create", "item_update", "item_complete"],
      "persona": ["todo-rules", "personal-items-rules"],
      "api": ["board"],
      "service": ["personal-items"]
    }
  },
  "nav": {
    "label": "待办",
    "icon": "todo",
    "order": 50,
    "mode": "iframe",
    "page": "/page"
  },
  "apiVersion": 3,
  "capabilityIndex": [
    {
      "id": "personal.items",
      "name": "个人事项",
      "description": "记录、改期、完成和查询个人任务与计划。",
      "tools": ["item_list", "item_get", "item_create", "item_update", "item_complete"],
      "aliases": [
        "待办",
        "任务",
        "事项",
        "提醒我",
        "安排",
        "安排事项",
        "个人事项",
        "计划",
        "日历",
        "日程",
        "日程安排",
        "todo",
        "task",
        "plan",
        "reminder",
        "calendar",
        "event",
        "schedule"
      ],
      "inputs": ["title", "date", "time-zone", "priority"],
      "outputs": ["personal-item"],
      "risk": "low",
      "sideEffect": "write"
    },
    {
      "id": "agent.progress",
      "name": "执行步骤",
      "description": "维护当前多步任务的进度，不混入个人事项。",
      "tools": ["todo_add", "todo_update", "todo_list"],
      "aliases": ["执行清单", "多步进度"],
      "outputs": ["progress-card"],
      "risk": "low",
      "sideEffect": "write"
    }
  ]
}
