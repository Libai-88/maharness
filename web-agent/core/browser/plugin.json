{
  "id": "browser",
  "name": "浏览器",
  "version": "0.1.0",
  "entry": "index.ts",
  "enabled": true,
  "compatibility": { "api": { "min": "1.0.0", "max": "1.0.0" } },
  "limits": { "lifecycleTimeoutMs": 30000 },
  "permissions": { "capabilities": {
    "tool": ["browser_open", "browser_snapshot", "browser_network", "browser_download", "browser_click", "browser_type", "browser_press", "browser_close", "browser_screenshot"],
    "persona": ["browser-rules"]
  } },
  "config": {
    "type": "object",
    "properties": {
      "enabled": { "type": "boolean" },
      "executablePath": { "type": "string" },
      "headless": { "type": "boolean" },
      "persistent": { "type": "boolean" },
      "allowPrivate": { "type": "boolean" },
      "maxChars": { "type": "integer", "minimum": 500, "maximum": 40000 }
    }
  }
}
