{
  "id": "search",
  "name": "联网搜索",
  "version": "0.1.0",
  "entry": "index.ts",
  "enabled": true,
  "compatibility": {
    "api": {
      "min": "2.0.0",
      "max": "2.0.0"
    }
  },
  "limits": {
    "lifecycleTimeoutMs": 30000
  },
  "permissions": {
    "capabilities": {
      "tool": [
        "web_search",
        "web_fetch",
        "web_crawl"
      ],
      "persona": [
        "search-rules"
      ]
    }
  },
  "apiVersion": 2
}
