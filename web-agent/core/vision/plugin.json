{
  "id": "vision",
  "name": "图像能力",
  "version": "0.1.0",
  "entry": "index.ts",
  "enabled": true,
  "requires": [
    "chat"
  ],
  "compatibility": {
    "api": {
      "min": "2.0.0",
      "max": "2.0.0"
    }
  },
  "limits": {
    "lifecycleTimeoutMs": 30000
  },
  "permissions": {
    "capabilities": {
      "tool": [
        "read_image",
        "analyze_image"
      ],
      "persona": [
        "vision-rules"
      ]
    }
  },
  "apiVersion": 2
}
