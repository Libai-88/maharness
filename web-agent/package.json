{
  "name": "maharness",
  "version": "0.1.0",
  "private": true,
  "description": "maharness：自研 Windows 原生网页版 Agent——薄内核 + 全插件化 + 全程可观测，agent 可以自己定义自己",
  "bin": {
    "maharness": "./bin/maharness.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "link": "npm link",
    "dev": "tsx watch server/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "start": "tsx server/index.ts",
    "start:all": "npm run ui:build && npm start",
    "selftest": "tsx scripts/selftest.ts",
    "plugin:scaffold": "node scripts/plugin-scaffold.mjs",
    "plugin:validate": "node scripts/plugin-scaffold.mjs validate",
    "plugin:lock": "tsx scripts/plugin-lock.ts generate",
    "plugin:lock:verify": "tsx scripts/plugin-lock.ts verify",
    "plugin:lock:sign": "tsx scripts/plugin-lock.ts sign",
    "skill:eval": "tsx scripts/skill-eval.ts",
    "skill:lock:verify": "tsx scripts/skill-lock.ts verify",
    "skill:lock:sign": "tsx scripts/skill-lock.ts sign",
    "tenant:backup": "tsx scripts/tenant-workspace.ts backup",
    "tenant:restore": "tsx scripts/tenant-workspace.ts restore",
    "tenant:backups": "tsx scripts/tenant-workspace.ts list",
    "test": "node scripts/run-tests.mjs",
    "test:security": "node --import tsx --test core/powershell/tests/approval-bypass.spec.ts core/tools-fs/tests/read-boundary.spec.ts kernel/tests/sandbox.spec.ts core/search/tests/ssrf.spec.ts server/tests/providers.spec.ts server/tests/ssrf.spec.ts core/mcp/tests/security.spec.ts server/tests/auth.spec.ts core/chat/tests/tool-broker.spec.ts server/tests/plugin-grants.spec.ts core/self-extend/tests/task-plugins.spec.ts",
    "check:threat-model": "node scripts/check-threat-model.mjs",
    "eval": "tsx scripts/agent-eval.ts",
    "eval:ci": "tsx scripts/agent-eval.ts --baseline evals/replay-v2-baseline.json",
    "eval:optimization": "tsx scripts/optimization-eval.ts",
    "eval:workbench": "tsx scripts/workbench-eval.ts",
    "eval:workbench:live": "tsx scripts/workbench-live.ts",
    "eval:long-content:live": "tsx scripts/workbench-live.ts --long-content",
    "eval:live": "tsx scripts/eval-live.ts",
    "eval:release": "tsx scripts/release-live.ts",
    "eval:strengthening": "tsx scripts/strengthening-live.ts",
    "eval:release:report": "tsx scripts/release-report.ts",
    "typecheck": "tsc -p tsconfig.json",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:typecheck": "npm --prefix ui run typecheck",
    "e2e": "npm --prefix ui run e2e",
    "build": "npm run ui:typecheck && npm run ui:build && npm run typecheck",
    "eval:composition": "tsx scripts/composition-live.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^11.10.0",
    "docx": "^9.15.4",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "undici": "^8.10.0",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0"
  }
}
