{
  "name": "maharness",
  "version": "0.1.0",
  "private": true,
  "description": "maharness：自研 Windows 原生网页版 Agent——薄内核 + 全插件化 + 全程可观测，agent 可以自己定义自己",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "selftest": "tsx scripts/selftest.ts",
    "typecheck": "tsc -p tsconfig.json",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "build": "npm run ui:build && npm run typecheck"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
